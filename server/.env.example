# Port this API listens on inside its container
PORT=4000

# Only these origins may call /provision/device (the admin panel). Comma-separated.
ADMIN_ORIGIN=https://farmbuddie-cloud.web.app,https://farmbuddie-cloud.firebaseapp.com

# Firebase Admin SDK service account. Mount the JSON file into the container and point here.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json

# TBMQ REST API, reachable over the internal docker network (service name, not localhost)
TBMQ_BASE_URL=http://tbmq:8083
TBMQ_ADMIN_EMAIL=sysadmin@thingsboard.org
TBMQ_ADMIN_PASSWORD=changeme

# What devices/apps are told to connect to (the public TLS listener)
MQTT_BROKER_HOST=mqtt.farmbuddie.com
MQTT_BROKER_PORT=8883

# --- Bridge service only (server/src/bridge, run separately — see README) ---
# One fixed TBMQ credential for the bridge itself: subAuthRulePatterns
# farm/+/.* and pubAuthRulePatterns farm/+/.* (broad read+write — this is
# infrastructure, not a per-customer credential, so it's created once via
# the TBMQ REST API directly, not through /provision/*).
BRIDGE_MQTT_URL=mqtt://tbmq:1883
BRIDGE_MQTT_USERNAME=bridge
BRIDGE_MQTT_PASSWORD=changeme
BRIDGE_PORT=4100
# Postgres running in the same docker-compose stack as TBMQ — a separate
# database from TBMQ's own, same instance. e.g.:
# postgresql://bridge:PASSWORD@postgres:5432/farmbuddie_bridge
BRIDGE_PG_CONNECTION_STRING=
